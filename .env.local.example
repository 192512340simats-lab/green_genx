# =====================================================================
# GREEN GENX environment variables
# 1. Copy this file to  .env.local   (same folder)
# 2. Fill in the real values
# 3. NEVER commit .env.local to GitHub (it is already in .gitignore)
# In Vercel: Project -> Settings -> Environment Variables (add the same four)
# =====================================================================

# Supabase Dashboard -> Project Settings -> API -> "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase Dashboard -> Project Settings -> API -> "anon public" key
# (safe for browsers; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Supabase Dashboard -> Project Settings -> API -> "service_role" key
# !!! SECRET. Server only. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_, never paste into frontend code or chat.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Random secret (>= 32 chars) used to hash IP addresses for rate limiting.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE

# Public URL of the site. Used inside gate-pass QR codes and for CSRF checks.
#   Local:       http://localhost:3000
#   Production:  https://your-project.vercel.app   (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
